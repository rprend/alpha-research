ds": {"doi": {"identifier": "10.17613/j7jt-b052", "provider": "datacite", "client": "datacite"}, "oai": {"identifier": "oai:invenio-dev.hcommons-staging.org:wv2mz-m9p64", "provider": "oai"}}, "metadata": {"resource_type": {"id": "presentation-conferencePaper", "title": {"de": "Konferenzbeitrag", "en": "Conference paper"}}, "creators": [{"person_or_org": {"type": "personal", "name": "Palladino, Chiara", "given_name": "Chiara", "family_name": "Palladino"}, "role": {"id": "author", "title": {"en": "Author"}}}, {"person_or_org": {"type": "personal", "name": "Karimi, Farimah", "given_name": "Farimah", "family_name": "Karimi"}, "role": {"id": "author", "title": {"en": "Author"}}}, {"person_or_org": {"type": "personal", "name": "Mathiak, Brigitte", "given_name": "Brigitte", "family_name": "Mathiak", "identifiers": [{"identifier": "brigittemathiak", "scheme": "hc_username"}]}, "role": {"id": "author", "title": {"en": "Author"}}, "affiliations": [{"name": "Institute For Digital Humanities"}]}], "title": "NER on Ancient Greek with minimal annotation", "publisher": "DH2020", "publication_date": "2020", "subjects": [{"id": "http://id.worldcat.org/fast/1095153", "subject": "Research", "scheme": "FAST-topical"}, {"id": "http://id.worldcat.org/fast/963599", "subject": "Digital humanities", "scheme": "FAST-topical"}, {"id": "http://id.worldcat.org/fast/1018722", "subject": "Methodology", "scheme": "FAST-topical"}], "dates": [{"date": "2020-07-21", "type": {"id": "issued", "title": {"de": "Ver\u00f6ffentlicht", "en": "Issued", "sv": "Utf\u00e4rdad"}}, "description": "Publication date"}], "languages": [{"id": "eng", "title": {"en": "English"}}], "identifiers": [{"identifier": "hc:31889", "scheme": "hclegacy-pid"}, {"identifier": "1000360-35292", "scheme": "hclegacy-record-id"}, {"identifier": "https://dh2020.adho.org/wp-content/uploads/2020/07/145_NERonAncientGreektextswithminimalannotation.html", "scheme": "url"}], "rights": [{"id": "cc-by-nc-sa-4.0", "title": {"en": "Creative Commons Attribution Non Commercial Share Alike 4.0 International"}, "description": {"en": ""}, "icon": "cc-by-nc-sa-icon", "props": {"url": "https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode", "scheme": "spdx"}}], "description": "This paper presents the results in the adaptation of a new workflow of Named Entity Recognition and classification applied to Ancient Greek. We used a model of data extraction and pattern discovery based on machine learning algorithms which is easily customizable for different languages. This allowed the creation of a dataset of automatically classified place-names and ethnonyms starting from a small manually annotated list. We worked on the assumption that premodern textual sources display a recognized systematicity in their linguistic encoding of space, which provides a test-case for automatic context-based methods. The idea is that we should be able to train the machine to recognize an entity from recurring elements in the context, without providing a large training dataset in advance."}, "custom_fields": {"meeting:meeting": {"dates": "21.07.2020", "place": "online", "title": "DH2020"}, "imprint:imprint": {"title": "https://dh2020.adho.org/"}, "kcr:commons_domain": "hcommons.org", "kcr:edition": "abstract", "kcr:meeting_organization": "ADHO", "kcr:submitter_email": "bmathiak@uni-koeln.de", "kcr:submitter_username": "brigittemathiak", "kcr:commons_search_recid": "rQfyQpMBo6y43HVFR4eK", "kcr:commons_search_updated": "2024-11-19T05:43:14.871709+00:00", "kcr:user_defined_tags": ["Conditional Random Fields", "Herodot", "Named Entity Recognition", "Digital humanities research and methodology"], "hclegacy:collection": "hccollection:1", "hclegacy:file_location": "/srv/www/commons/current/web/app/uploads/humcore/2020/07/o_1edos3qn3a1l9cte0s11sv1jko7.pdf.places-and-ethnicities-in-herodot-dh-2020.pdf", "hclegacy:file_pid": "hc:31890", "hclegacy:previously_published": "published", "hclegacy:publication_type": "online-publication", "hclegacy:rec