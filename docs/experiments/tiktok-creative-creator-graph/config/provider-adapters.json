{
  "version": "2026-06-12",
  "apify": {
    "base_url": "https://api.apify.com/v2",
    "actors": {
      "tiktok_hashtag_export": {
        "actor_id": "clockworks/tiktok-scraper",
        "input_template": {
          "hashtags": ["{{query}}"],
          "resultsPerPage": "{{limit}}",
          "shouldDownloadVideos": false,
          "shouldDownloadCovers": false,
          "shouldDownloadSubtitles": false
        }
      },
      "tiktok_creator_neighborhood_export": {
        "actor_id": "clockworks/tiktok-scraper",
        "input_template": {
          "profiles": ["https://www.tiktok.com/{{query}}"],
          "resultsPerPage": "{{limit}}",
          "shouldDownloadVideos": false,
          "shouldDownloadCovers": false,
          "shouldDownloadSubtitles": false
        }
      },
      "tiktok_profile_export": {
        "actor_id": "clockworks/tiktok-scraper",
        "input_template": {
          "profiles": ["https://www.tiktok.com/{{query}}"],
          "resultsPerPage": "{{limit}}",
          "shouldDownloadVideos": false,
          "shouldDownloadCovers": false,
          "shouldDownloadSubtitles": false
        }
      },
      "search_index": {
        "actor_id": "apify/google-search-scraper",
        "input_template": {
          "queries": "{{query}}",
          "maxPagesPerQuery": 1,
          "resultsPerPage": "{{limit}}",
          "countryCode": "us",
          "languageCode": "en"
        }
      },
      "category_gap_search": {
        "actor_id": "apify/google-search-scraper",
        "input_template": {
          "queries": "{{query}}",
          "maxPagesPerQuery": 1,
          "resultsPerPage": "{{limit}}",
          "countryCode": "us",
          "languageCode": "en"
        }
      },
      "cross_platform_search": {
        "actor_id": "apify/google-search-scraper",
        "input_template": {
          "queries": "{{query}}",
          "maxPagesPerQuery": 1,
          "resultsPerPage": "{{limit}}",
          "countryCode": "us",
          "languageCode": "en"
        }
      }
    }
  },
  "public_web": {
    "base_url": "",
    "actors": {
      "search_index": {
        "actor_id": "bing_html",
        "input_template": {
          "query": "{{query}}",
          "limit": "{{limit}}"
        }
      },
      "category_gap_search": {
        "actor_id": "bing_html",
        "input_template": {
          "query": "{{query}}",
          "limit": "{{limit}}"
        }
      },
      "cross_platform_search": {
        "actor_id": "bing_html",
        "input_template": {
          "query": "{{query}}",
          "limit": "{{limit}}"
        }
      }
    }
  }
}
