{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alpha-research",
  "account_id": "0e1651bc459f3017e816ba2263e0807a",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL_PLANE",
        "class_name": "ControlPlane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-control-plane",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "alpharesearch.nyc/*",
      "zone_name": "alpharesearch.nyc"
    },
    {
      "pattern": "dashboard.alpharesearch.nyc/*",
      "zone_name": "alpharesearch.nyc"
    },
    {
      "pattern": "docs.alpharesearch.nyc/*",
      "zone_name": "alpharesearch.nyc"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
